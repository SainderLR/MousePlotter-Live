#!/bin/bash
# MousePlotter Live main menu, started on tty1 after the automatic login.
set -u

results=$HOME/results
mkdir -p "$results" || exit 1
cd "$results" || exit 1

# A separate directory for each boot prevents old recordings being overwritten.
session_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
if [[ ! $session_id =~ ^[a-zA-Z0-9-]+$ ]]; then
	session_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
fi
save_path="MousePlotter/$session_id/results"
save_status="not saved yet; exit the recorder to save"
save_mount=/mnt/mpdata
save_mounted=0
data_device=
data_type=
data_error=

pause() {
	read -rsn1 -p "Press any key to return to the menu."
	echo
}

network_up() {
	systemctl is-active -q NetworkManager
}

network_status() {
	if network_up; then
		echo "on, $(nmcli -t -f STATE general 2>/dev/null)"
	else
		echo "off"
	fi
}

network_on() {
	clear
	sudo systemctl start NetworkManager
	sudo nmcli radio all on 2>/dev/null
	sudo nmcli networking on
	if nmcli -t -f TYPE device 2>/dev/null | grep -qx wifi; then
		# nmtui lists only networks already found, so give the first scan of
		# the just switched on Wi-Fi device up to 10 seconds to find some.
		echo "Scanning for Wi-Fi networks..."
		local i
		for i in $(seq 20); do
			[ -n "$(nmcli -t -f SSID device wifi list --rescan no 2>/dev/null)" ] && break
			sleep 0.5
		done
		sudo nmtui connect
	else
		echo "No Wi-Fi device found. Ethernet and USB tethering connect automatically."
		pause
	fi
}

# Take every interface down and switch radios off, so no network interrupts
# or Wi-Fi scans run during a recording.
network_off() {
	if network_up; then
		sudo nmcli networking off
		sudo nmcli radio all off
		sudo systemctl stop NetworkManager wpa_supplicant
	fi
	local dev
	for dev in /sys/class/net/*; do
		[ "${dev##*/}" = lo ] || sudo ip link set "${dev##*/}" down
	done
}

record() {
	clear
	# A failed unmount must be resolved before starting another recording.
	if ! release_save_mount; then
		echo "Cannot record while the USB save partition is still mounted."
		pause
		return
	fi
	if findmnt -rn --mountpoint "$save_mount" >/dev/null ||
		{ find_data_partition && findmnt -rn --source "$data_device" >/dev/null; }; then
		echo "MPDATA is mounted. Unmount it before recording to keep USB storage idle."
		echo "Use S (Shell) to unmount MPDATA, then return here."
		pause
		return
	fi
	if network_up; then
		echo "Note: the network is on. Wi-Fi and Ethernet interrupts can show up as"
		echo "timing jitter; turn the network off from the menu (O) for the cleanest data."
		echo
	fi
	# MOUSEPLOTTER_NO_PM_QOS keeps the CLI from overriding the idle states
	# chosen with T. Keep the output on screen only if the CLI failed (e.g. no
	# mouse found).
	sudo MOUSEPLOTTER_NO_PM_QOS=1 /usr/local/bin/mouseplotter || pause
}

keyboard() {
	clear
	local XKBLAYOUT= XKBVARIANT= layout variant
	. /etc/default/keyboard
	echo "Current keyboard layout: ${XKBLAYOUT:-us} ${XKBVARIANT}"
	echo
	echo "Enter a layout code, optionally followed by a variant, for example:"
	echo "  us   gb   de   fr   es   it   se   no   dk   pl   ru   jp   us dvorak"
	echo
	read -rp "Layout (empty to cancel): " layout variant
	[ -n "$layout" ] || return
	if [[ ! $layout =~ ^[a-z]+$ || ! $variant =~ ^[a-z0-9_-]*$ ]] ||
		[ ! -e "/usr/share/X11/xkb/symbols/$layout" ]; then
		echo "Unknown layout: $layout"
		pause
		return
	fi
	sudo sed -i -e "s/^XKBLAYOUT=.*/XKBLAYOUT=\"$layout\"/" \
		-e "s/^XKBVARIANT=.*/XKBVARIANT=\"$variant\"/" /etc/default/keyboard
	sudo setupcon -k --force
	# X reads the layout from udev properties imported from /etc/default/keyboard.
	sudo udevadm trigger --subsystem-match=input --action=change
}

# With toram, live-boot copies the system to RAM (a tmpfs at the medium's
# mount point) and releases the USB drive.
boot_drive_status() {
	if [ "$(findmnt -no FSTYPE /run/live/medium)" = tmpfs ]; then
		echo "not in use by system; keep plugged in for USB saves"
	else
		echo "in use, keep it plugged in"
	fi
}

# Read the device list only at the menu or after the recorder has exited.
# Never pick one of several partitions that share the label.
find_data_partition() {
	local devices device label type matches=0
	data_device= data_type= data_error=
	if ! devices=$(lsblk -prno NAME,LABEL,FSTYPE 2>/dev/null); then
		data_error="cannot check MPDATA partitions"
		return 1
	fi
	while read -r device label type; do
		[ "$label" = MPDATA ] || continue
		data_device=$device
		data_type=$type
		matches=$((matches + 1))
	done <<< "$devices"
	case "$matches" in
	0) data_error="MPDATA not found" ;;
	1) return 0 ;;
	*) data_error="multiple MPDATA partitions found; keep only one connected" ;;
	esac
	return 1
}

release_save_mount() {
	[ "$save_mounted" = 1 ] || return 0
	if ! sudo umount "$save_mount"; then
		save_status="SAVE FAILED: cannot unmount MPDATA"
		echo "$save_status"
		return 1
	fi
	save_mounted=0
}

results_have_data() {
	[ -n "$(find "$results" -mindepth 1 -print -quit)" ]
}

save_failed() {
	save_status="SAVE FAILED: $1; results remain in RAM"
	echo "$save_status"
	return 1
}

# Copy synchronously after exiting the recorder or before shutdown. The save
# partition is flushed and unmounted before another recording can start.
save_results() {
	local failed=0
	release_save_mount || return 1
	results_have_data || return 0
	find_data_partition || { save_failed "$data_error"; return 1; }
	if [ "$data_type" != exfat ]; then
		save_failed "MPDATA must be formatted as exFAT"
		return 1
	fi
	# Do not reuse or unmount a partition mounted by another program.
	if findmnt -rn --mountpoint "$save_mount" >/dev/null ||
		findmnt -rn --source "$data_device" >/dev/null; then
		save_failed "MPDATA or $save_mount is already mounted; unmount it first"
		return 1
	fi
	if ! sudo mkdir -p "$save_mount" ||
		! sudo mount -t exfat -o "uid=$(id -u),gid=$(id -g),noatime" "$data_device" "$save_mount"; then
		save_failed "cannot mount MPDATA"
		return 1
	fi
	save_mounted=1
	if ! mkdir -p "$save_mount/$save_path" ||
		! rsync -rtc --modify-window=1 "$results/" "$save_mount/$save_path/"; then
		save_failed "copy to MPDATA failed (check available space)"
		failed=1
	fi
	if ! sync -f "$save_mount"; then
		save_failed "flushing MPDATA failed"
		failed=1
	fi
	release_save_mount || failed=1
	[ "$failed" = 0 ] || return 1
	save_status="saved to MPDATA/$save_path"
	echo "$save_status"
}

usb_save_status() {
	if find_data_partition; then
		echo "MPDATA found, keep plugged in; $save_status"
	else
		echo "$data_error; $save_status"
	fi
}

shutdown() {
	local action=$1 answer
	clear
	if ! save_results; then
		echo
		echo "USB backup failed. Powering off or rebooting loses results kept in RAM."
		read -rp "Type YES to $action anyway, or press Enter to return: " answer
		[ "$answer" = YES ] || return 0
	fi
	sudo systemctl "$action"
}

shell() {
	clear
	echo "Type 'exit' to return to the menu. sudo needs no password."
	bash
}

trap 'release_save_mount || true' EXIT

while true; do
	clear
	count=$(find "$results" -maxdepth 1 -type f | wc -l)
	cat <<EOF

  MousePlotter Live

  CPU       $(/usr/local/sbin/mouseplotter-tune status)
  Network   $(network_status)
  Results   ~/results, $count file(s) in RAM; USB backup status below
  USB drive $(boot_drive_status)
  USB save  $(usb_save_status)

  R  Record mouse data           H  Web browser, results
  N  Network on / Wi-Fi setup    O  Network off
  T  Next idle-state level       K  Keyboard layout
  S  Shell                       P  Power off        B  Reboot

EOF
	read -rsn1 key
	case "$key" in
	r | R) record; save_results || pause ;;
	h | H) xdg-open "$results/" ;;
	n | N) network_on ;;
	o | O) network_off ;;
	t | T) sudo /usr/local/sbin/mouseplotter-tune next ;;
	k | K) keyboard ;;
	s | S) shell ;;
	p | P) shutdown poweroff ;;
	b | B) shutdown reboot ;;
	esac
done
